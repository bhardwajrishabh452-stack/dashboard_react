pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/bhardwajrishabh452-stack/dashboard_react.git'
                )
            }
        }

        stage('Check Node') {
            steps {
                sh '''
                    echo "=============================="
                    echo "Node.js Version"
                    echo "=============================="
                    node --version

                    echo "=============================="
                    echo "NPM Version"
                    echo "=============================="
                    npm --version

                    echo "=============================="
                    echo "Node Location"
                    echo "=============================="
                    which node

                    echo "=============================="
                    echo "NPM Location"
                    echo "=============================="
                    which npm
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo '       BUILD SUCCESSFUL'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo '       BUILD FAILED'
            echo '======================================'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}
