pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/bhardwajrishabh452-stack/dashboard_react.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo '       BUILD SUCCESSFUL ✅'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo '       BUILD FAILED ❌'
            echo '       Check Console Output'
            echo '======================================'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}
