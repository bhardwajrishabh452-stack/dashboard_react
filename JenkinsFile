pipeline {

    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('SCM Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/bhardwajrishabh452-stack/dashboard_react.git'
                )
            }
        }

        stage('Check Environment') {
            steps {
                sh '''
                    echo "Node version:"
                    node --version

                    echo "NPM version:"
                    npm --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test -- --run'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
    }

    post {
        success {
            echo '===================================='
            echo 'PIPELINE SUCCESSFUL ✅'
            echo '===================================='
        }

        failure {
            echo '===================================='
            echo 'PIPELINE FAILED ❌'
            echo 'Check the stage that failed.'
            echo '===================================='
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
